<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+) — the launcher masks foreground+background into
     whatever shape the device theme uses (circle, squircle, ...). The flat
     mipmap-*/ic_launcher.png in the other density folders is the pre-26
     fallback, same glyph on the same purple, just pre-composited. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/pileus_purple"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
