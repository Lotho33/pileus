<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ── Form factor: TV only ────────────────────────────────────────────
         Without an explicit <uses-feature>, Play and Amazon treat
         android.hardware.touchscreen as REQUIRED — every Android TV / Fire
         TV reports no touchscreen, so the app would be filtered off every
         device it actually targets. `required="false"` fixes that.

         android.software.leanback required="true" makes this a TV-only
         listing (mobile/desktop are a separate app). If an older Fire TV
         model that doesn't report the leanback feature ever needs to be
         supported, flip this one attribute to "false" — the LEANBACK_LAUNCHER
         category (src/tv/AndroidManifest.xml) is what actually places the app on the TV home
         screen. faketouch / wifi / gamepad are declared optional so no TV
         box is excluded for lacking them. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="true"/>
    <uses-feature android:name="android.hardware.faketouch" android:required="false"/>
    <uses-feature android:name="android.hardware.wifi" android:required="false"/>
    <uses-feature android:name="android.hardware.gamepad" android:required="false"/>

    <!-- The debug/profile manifests (src/debug, src/profile) each grant this
         separately for Flutter's own dev tooling (hot reload, DevTools),
         which reads as "only needed for development" — but the app itself
         makes real network calls (gRPC to mycelium-core, HTTP discovery) in
         every build variant, release included. Without it here too, every
         socket/HTTP attempt in a release build fails silently (caught by
         the surrounding try/catch in host_resolver.dart/
         server_discovery_screen.dart as just "not reachable"), which reads
         exactly like "the server isn't found" even though it's actually
         "no build has permission to open a socket at all" — release was
         missing this permission entirely; debug/profile only ever worked
         because their own manifests granted it independently.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Pulled in transitively by a player dependency (no Flutter plugin
         declares it directly — it comes from an ExoPlayer-related native
         library), not something Pileus itself has any use for: there's no
         scheduled work or alarm here that would need to survive a reboot.
         Stripped from the merged manifest rather than left unexplained for
         a store reviewer. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove"/>

    <!-- better_player_plus declares a mediaPlayback foreground service (+ its
         two permissions) that it only ever starts from
         setupPlayerNotification(), i.e. when a BetterPlayerDataSource carries
         a notificationConfiguration with showNotification: true. Pileus never
         does (no background playback, no media notification — see
         player_engine.dart), so the service is dead weight; and with
         targetSdk >= 34 a declared FOREGROUND_SERVICE_MEDIA_PLAYBACK makes
         the Play Console demand a foreground-service declaration + demo
         video. Stripped here for both flavors. The plugin's own stop() call
         (on dispose) is wrapped in a try/catch and stopService() on an
         undeclared component is a plain no-op. If background playback /
         a media notification is ever added, drop these three lines and file
         the Play declaration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove"/>

    <!-- Pileus is a bring-your-own-server client: users point it at their own
         mycelium box, which on a LAN almost always serves gRPC and the HLS
         stream proxy over plain http://. ExoPlayer's HTTP data source
         (unlike libmpv's own FFmpeg networking, which ignored the OS policy)
         enforces the platform cleartext policy, and with targetSdk >= 28
         that defaults to "blocked" — so without usesCleartextTraffic the
         video load fails with a bare "Source error" on every http stream.
         dart:io sockets (gRPC / discovery) bypass the policy, so this only
         started mattering once playback moved to ExoPlayer. -->
    <application
        android:label="Pileus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Engine flags (Impeller backend etc.) are NOT set here: the
                 Flutter engine only reads them from <application> meta-data
                 (FlutterLoader → ApplicationInfo.metaData), so the
                 ImpellerBackend / EnableImpeller / EnableSurfaceControl
                 entries that used to sit on this <activity> were silently
                 ignored (EnableSurfaceControl no longer exists at all since
                 Flutter 3.47). The TV flavor sets the backend in
                 src/tv/AndroidManifest.xml. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The LEANBACK_LAUNCHER intent-filter (TV home screen entry)
                 lives in src/tv/AndroidManifest.xml, not here: in src/main
                 the mobile flavor inherited it too, which makes Play treat
                 the phone app as TV-capable (TV quality review, and a
                 missing-banner error since mobile strips the banner). -->
        </activity>
        <!-- See the FOREGROUND_SERVICE permissions above. -->
        <service
            android:name="uz.shs.better_player_plus.BetterPlayerForegroundService"
            tools:node="remove"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
