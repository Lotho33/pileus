<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tizen (Samsung Smart TV) packaging manifest for Pileus — built by
  scripts/build-tizen.sh (see docs/TIZEN_WEBOS.md), which copies it into
  build/tizen/app/ with `version` synced from pubspec.yaml and signs the
  .wgt with the active Tizen Studio certificate profile.

  `tizen:application id`/`package` (pileustv01) must never change once the
  app is on the Samsung store: it's the app's identity across updates.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/Lotho33/pileus"
        version="1.5.1"
        viewmodes="maximized">

  <tizen:application id="pileustv01.PileusTV"
                      package="pileustv01"
                      required_version="4.0"/>

  <name>Pileus</name>
  <icon src="icon.png"/>
  <content src="index.html"/>

  <!-- Internet access — required for every gRPC-Web/HTTP call this app
       makes (both LAN and remote/HTTPS server mode, see
       lib/core/grpc/server_address.dart). Without this privilege Tizen
       blocks outgoing requests entirely at the platform level, independent
       of any CORS/CSP configured on the server side. -->
  <tizen:privilege name="http://tizen.org/privilege/internet"/>

  <!-- Media keys (Play/Pause/Stop/FF/RW) reach the app only after
       tizen.tvinputdevice.registerKey() — see web/index.html. -->
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

  <!-- webapis.network.getIp(): the TV's own LAN IP for the discovery
       screen's /24 sweep (web/index.html, pileusLocalIps). Public-level
       Samsung privilege, unlike the platform-level network.get below. -->
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>

  <!-- network.get was declared here defensively for a hypothetical future
       native Tizen network-info API — never actually reached by any Dart
       code on this entry point (kIsWeb-gated no-op). Removed: a basic
       author-only certificate (not a Samsung partner/platform-level one)
       gets install error 118019 ("restricted privilege") for it, confirmed
       against a real TV. -->

  <feature name="http://tizen.org/feature/screen.size.all"/>

  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>

  <!-- Every request this app makes is cross-origin by construction (see
       main_web_tv.dart's own doc: a packaged app is never "served by
       mycelium", so there is no same-origin host to default to — manual
       server entry, LAN or remote/HTTPS, is the only path). Wide open
       because the actual server address is only known at runtime (typed
       by the person pairing the TV), not at build time. -->
  <access origin="*" subdomains="true"/>

  <tizen:profile name="tv-samsung"/>

  <!-- Lets the remote's dedicated Return/Back key reach the app as a key
       event at all — without this some Tizen TV profiles intercept it at
       the platform level before it ever reaches the WebView. Paired with
       web/index.html's key bridge (keyCode 10009 → GoBack). -->
  <tizen:metadata key="http://samsung.com/tv/metadata/use.dialog.hwkey" value="true"/>
</widget>
